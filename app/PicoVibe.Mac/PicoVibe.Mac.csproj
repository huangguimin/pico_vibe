<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PicoVibe</AssemblyName>
    <RootNamespace>PicoVibe.Mac</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PicoVibe.Core\PicoVibe.Core.csproj" />
    <ProjectReference Include="..\PicoVibe.Runtime\PicoVibe.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\PicoVibe.App\Assets\PicoVibe.png" Link="Assets\PicoVibe.png" />
  </ItemGroup>
</Project>
